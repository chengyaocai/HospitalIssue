# 后端环境变量示例。复制为 .env 后按实际环境修改。

# 服务端口
PORT=3000

# 数据库驱动：mssql=连接 SQL Server（生产）；dev=本地 JSON 文件（免数据库，便于本地测试）
DB_DRIVER=mssql

# dev 模式下 JSON 数据文件路径（DB_DRIVER=dev 时生效）
DEV_DB_PATH=./data/issues.json

# ===== SQL Server 连接（DB_DRIVER=mssql 时生效）=====
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=HospitalIssue
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong@Passw0rd
# 是否加密连接（公网/云数据库建议 true）
MSSQL_ENCRYPT=false
# 自签证书信任（内网/测试建议 true）
MSSQL_TRUST_CERT=true

# ===== 登录鉴权 =====
# JWT 签名密钥：生产务必改为强随机字符串
JWT_SECRET=dev-only-secret-change-me
# 首次启动自动创建的管理员账号（dev / mssql 均生效）
ADMIN_USER=admin
ADMIN_NAME=系统管理员
ADMIN_PASSWORD=admin123
# dev 模式下用户存放的 JSON 文件路径
DEV_USERS_PATH=./data/users.json

# ===== 附件与审计 =====
# 上传附件保存目录
UPLOADS_DIR=./uploads
# dev 模式下审计日志的 JSON 文件路径
AUDIT_DEV_PATH=./data/audit.json

# ===== 系统设置 =====
# 左上角显示的系统名称（默认值；管理员也可在界面「系统设置」里在线修改并持久化）
APP_NAME=医院信息科 · 软件问题登记
# dev 模式下系统设置的 JSON 文件路径
SETTINGS_DEV_PATH=./data/settings.json

# dev 模式下消息通知的 JSON 文件路径
NOTIFICATIONS_DEV_PATH=./data/notifications.json
